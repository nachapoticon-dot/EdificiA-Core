#!/bin/sh
set -eu

if [ "${SKIP_CHAT_SMOKE:-}" = "1" ]; then
  echo "SKIP_CHAT_SMOKE=1: se omite npm run smoke:chat"
  exit 0
fi

ZERO_SHA="0000000000000000000000000000000000000000"
WATCHED_REGEX='^(src/app/api/chat/route\.ts|src/lib/ai/(agent-prompt|model-router)\.ts|scripts/smoke-chat\.mjs|package(-lock)?\.json)$'
changed_files=""

while read -r local_ref local_sha remote_ref remote_sha
do
  if [ -z "${local_sha:-}" ] || [ "$local_sha" = "$ZERO_SHA" ]; then
    continue
  fi

  if [ "$remote_sha" = "$ZERO_SHA" ]; then
    default_remote=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
    base=""
    if [ -n "$default_remote" ]; then
      base=$(git merge-base "$local_sha" "$default_remote" 2>/dev/null || true)
    fi

    if [ -n "$base" ]; then
      files=$(git diff --name-only "$base" "$local_sha")
    else
      files=$(git diff-tree --no-commit-id --name-only -r "$local_sha")
    fi
  else
    files=$(git diff --name-only "$remote_sha" "$local_sha")
  fi

  changed_files="$changed_files
$files"
done

if [ -z "$(printf "%s\n" "$changed_files" | grep -E "$WATCHED_REGEX" || true)" ]; then
  exit 0
fi

echo "Cambios detectados en runtime/prompt/model-router del agente. Ejecutando smoke de chat..."
npm run smoke:chat
