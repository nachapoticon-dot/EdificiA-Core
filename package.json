    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "migrate:dry": "node --env-file-if-exists=.env.local scripts/migrate.mjs --dry-run",
    "migrate:new": "node scripts/migrate.mjs new"
  },
