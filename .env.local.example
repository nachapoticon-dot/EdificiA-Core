# Copiar a .env.local y completar. Nunca commitear valores reales.

# ── InsForge BaaS (auth, base de datos, storage) — obligatorio ───────────────
NEXT_PUBLIC_INSFORGE_URL=           # https://<appkey>.<region>.insforge.app
INSFORGE_SERVICE_ROLE_KEY=          # Admin key — solo server-side, nunca en variables NEXT_PUBLIC_
AUTH_STRICT_MODE=                   # Opcional. Default: true en production, false en desarrollo. false solo como break-glass.
PASSWORD_RESET_SECRET=              # Opcional; secreto HMAC para reset de password. Si falta, usa INSFORGE_SERVICE_ROLE_KEY.

# ── LLM (DeepSeek, API compatible con OpenAI) — obligatorio para el chat ─────
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-v4-flash          # Opcional. Modelo por defecto.
# Router de modelos (src/lib/ai/model-router.ts), ambos opcionales:
# AI_MODEL_FAST → chitchat y tareas simples (cae a AI_MODEL).
# AI_MODEL_DEEP → comparativas A vs B, contradicciones, cross-doc (cae a AI_MODEL_FAST).
AI_MODEL_FAST=
AI_MODEL_DEEP=

# ── Embeddings (NVIDIA NIM, modelo baai/bge-m3) — opcional ───────────────────
# Sin esta clave el RAG cae a búsqueda de texto en PostgreSQL.
NVIDIA_API_KEY=

# ── Qdrant — vector database para RAG — opcional ─────────────────────────────
QDRANT_URL=                         # https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333 o http://localhost:6333
QDRANT_API_KEY=

# ── Resend — email transaccional (invitaciones, reset de password) ───────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=                  # onboarding@resend.dev (testing) o noreply@tudominio.com

# ── Administración ───────────────────────────────────────────────────────────
SUPER_ADMIN_KEY=                    # Protege /super-admin y /api/super-admin/*

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000   # Orígenes CORS permitidos para /api/*, separados por coma
LOG_LEVEL=                          # Opcional (pino): debug | info | warn | error
