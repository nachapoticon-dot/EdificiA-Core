# InsForge BaaS
NEXT_PUBLIC_INSFORGE_PROJECT_ID=
NEXT_PUBLIC_INSFORGE_URL=           # https://<appkey>.<region>.insforge.app
INSFORGE_SERVICE_ROLE_KEY=          # Admin key — nunca exponer en variables NEXT_PUBLIC_
AUTH_STRICT_MODE=                   # Opcional. Default: true en production, false en desarrollo. Setear false solo como break-glass.
PASSWORD_RESET_SECRET=              # Opcional; secreto HMAC para reset de password. Si falta, usa INSFORGE_SERVICE_ROLE_KEY.
CRON_SECRET=                        # Secreto Bearer para /api/cron/*; en prod debe ser distinto de SUPER_ADMIN_KEY.

# Anthropic / Vercel AI SDK
ANTHROPIC_API_KEY=

# Router de modelos (src/lib/ai/model-router.ts)
# AI_MODEL_FAST  → default para chitchat y tareas simples (cae a AI_MODEL).
# AI_MODEL_DEEP  → razonamiento complejo: comparativas A vs B, contradicciones,
#                  cross-doc. Si no se setea, usa el mismo que FAST.
AI_MODEL_FAST=
AI_MODEL_DEEP=

# Resend — transactional email (invitaciones de miembros)
# Crear API key en resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=           # onboarding@resend.dev (testing) o noreply@tudominio.com (producción)

# OpenAI — solo para embeddings (text-embedding-3-small)
# Sin esta clave el sistema usa búsqueda de texto en PostgreSQL como fallback
OPENAI_API_KEY=

# Qdrant Cloud — vector database para RAG
# Crear cluster en cloud.qdrant.io → obtener URL y API key
QDRANT_URL=               # https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
