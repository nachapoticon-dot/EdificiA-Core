# =====================================================================
# Variables de entorno — contrato validado en src/lib/env.ts (fail-fast al boot)
# Las REQUERIDAS hacen fallar el arranque del servidor si faltan.
# Las opcionales degradan funcionalidad pero no rompen el boot.
# =====================================================================

# --- REQUERIDAS ---

# InsForge BaaS
NEXT_PUBLIC_INSFORGE_URL=           # https://<appkey>.<region>.insforge.app
INSFORGE_SERVICE_ROLE_KEY=          # Admin key — nunca exponer en variables NEXT_PUBLIC_

# DeepSeek — modelo de IA del agente (vía SDK OpenAI-compatible)
DEEPSEEK_API_KEY=

# --- OPCIONALES ---

# Auth
AUTH_STRICT_MODE=                   # Default: true en production, false en desarrollo. false solo como break-glass.
PASSWORD_RESET_SECRET=              # Secreto HMAC para reset de password. Si falta, usa INSFORGE_SERVICE_ROLE_KEY.

# Super-admin / cron
SUPER_ADMIN_KEY=                    # Habilita /api/super-admin/*. Si falta, ese panel queda deshabilitado.
CRON_SECRET=                        # Bearer para /api/cron/*; en prod debe ser distinto de SUPER_ADMIN_KEY. Cae a SUPER_ADMIN_KEY.

# Router de modelos (src/lib/ai/model-router.ts). Si no se setean, usan AI_MODEL.
AI_MODEL=                           # Default interno: deepseek-v4-flash
AI_MODEL_FAST=                      # Chitchat y tareas simples (cae a AI_MODEL).
AI_MODEL_DEEP=                      # Razonamiento complejo: A vs B, contradicciones, cross-doc (cae a FAST).

# NVIDIA NIM — embeddings para RAG. Sin esta clave, RAG cae a búsqueda de texto en PostgreSQL.
NVIDIA_API_KEY=

# Qdrant Cloud — vector store para RAG. Sin esto, RAG opera en modo degradado.
QDRANT_URL=                         # https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=

# Resend — email transaccional (invitaciones, reset). Sin esto, el envío de email se omite.
RESEND_API_KEY=
RESEND_FROM_EMAIL=                  # onboarding@resend.dev (testing) o noreply@tudominio.com (producción)

# App / infra
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=                    # CSV de orígenes permitidos para CORS. Default: http://localhost:3000
LOG_LEVEL=                          # Default: debug en dev, info en prod
