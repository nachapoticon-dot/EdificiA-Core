{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, eslint.config.mjs, postcss.config.mjs, components.json, tsconfig.json",
    "next.config.ts": "next-env.d.ts, tsconfig.tsbuildinfo",
    "README.md": "CLAUDE.md, CONTRIBUTING.md, LICENSE",
    "docker-compose.yml": "Dockerfile, .env.docker, .env.docker.example",
    ".env.local": ".env.local.example",
    ".gitignore": ".gitattributes"
  },
  "files.exclude": {
    "**/.next": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.venv": true,
    "**/tsconfig.tsbuildinfo": true,
    "**/next-env.d.ts": true,
    "**/.DS_Store": true,
    ".github": true,
    "data": true
  }
}
