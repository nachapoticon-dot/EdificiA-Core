# Copy this file to .env.docker and fill in real values before running docker-compose.

# ── LLM ──────────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
AI_MODEL=deepseek-v4-flash
# Router de modelos (opcional): sobreescribe por tier.
# AI_MODEL_FAST queda con AI_MODEL si no se setea.
# AI_MODEL_DEEP se usa para comparativas A vs B, contradicciones, cross-doc, etc.
AI_MODEL_FAST=
AI_MODEL_DEEP=

# ── Infraestructura propia ───────────────────────────────────────────────────
DATABASE_URL=postgres://edificia:edificia_dev@postgres:5432/edificia
AUTH_JWT_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres
STORAGE_DIR=/app/data/storage
PASSWORD_RESET_SECRET=change-this-to-a-random-secret
CRON_SECRET=change-this-to-another-random-secret


# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com

# ── Admin ─────────────────────────────────────────────────────────────────────
SUPER_ADMIN_KEY=change-this-to-a-random-secret
