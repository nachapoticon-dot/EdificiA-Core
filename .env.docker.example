# Copy this file to .env.docker and fill in real values before running docker-compose.

# ── LLM ──────────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
AI_MODEL=deepseek-v4-flash
# Router de modelos (opcional): sobreescribe por tier.
# AI_MODEL_FAST queda con AI_MODEL si no se setea.
# AI_MODEL_DEEP se usa para comparativas A vs B, contradicciones, cross-doc, etc.
AI_MODEL_FAST=
AI_MODEL_DEEP=

# ── InsForge (Supabase-compatible backend) ───────────────────────────────────
NEXT_PUBLIC_INSFORGE_URL=https://your-project.insforge.io
INSFORGE_SERVICE_ROLE_KEY=eyJ...
PASSWORD_RESET_SECRET=change-this-to-a-random-secret
CRON_SECRET=change-this-to-another-random-secret

# ── Qdrant ───────────────────────────────────────────────────────────────────
# QDRANT_URL is set automatically by docker-compose (http://qdrant:6333)
# QDRANT_API_KEY is only needed if Qdrant is running with API key auth enabled
# QDRANT_API_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com

# ── Admin ─────────────────────────────────────────────────────────────────────
SUPER_ADMIN_KEY=change-this-to-a-random-secret
